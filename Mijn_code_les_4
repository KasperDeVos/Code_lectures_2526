def shortest_path(graph, src, dest):
    from math import inf

    dist = {node: inf for node in graph.get_all_nodes()}
    prev = {node: None for node in graph.get_all_nodes()}
    dist[src] = 0

    pq = PriorityQueue(sortkey=lambda node: dist[node])
    pq.add(src)

    visited = set()

    while not pq.is_empty():
        u = pq.poll()
        if u in visited:
            continue
        visited.add(u)

        if u == dest:
            break

        for edge in graph.get_outgoing_edges(u):
            v = edge.get_destination()
            w = edge.weight if edge.weight is not None else 1
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                prev[v] = u
                pq.add(v)

    if dist[dest] == inf:
        return None  # <-- geen pad

    # Reconstrueer pad
    path = []
    node = dest
    while node is not None:
        path.append(node)
        node = prev[node]
    path.reverse()
    return path
