def faculteit_rec(n):
    if n == 0:
        return 1
    else:
        return n * faculteit_rec(n-1)

def faculteit(n):
    i = 1
    result = 1
    while i <= n:
        result = result * i
        i += 1
    return result

def faculteit2(n):
    result = 1
    for i in range(1, n + 1):
        result = result * i
    return result

