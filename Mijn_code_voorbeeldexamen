import csv

class LinkedListNode:
    def __init__(self, task_name, duration, priority, next=None):
        self.task_name = task_name
        self.duration = duration
        self.priority = priority
        self.next = next

class LinkedList:
    def __init__(self):
        self.head = None

    def add_task(self, task_name, duration, priority):
        new_node = LinkedListNode(task_name, duration, priority)

        if self.head is None:
            self.head = new_node
            return

        current = self.head
        while current.next is not None:
            current = current.next
        current.next = new_node

    def remove_task(self, task_name):
        if task_name == self.head.task_name:
            self.head = self.head.next
        current = self.head
        while current.next.task_name != task_name:
            current = current.next
        current.next = current.next.next

    def display_tasks(self):
        current = self.head
        while current is not None:
            print(current.task_name)
            current = current.next

    def find_task(self, task_name):
        current = self.head
        while current is not None:
            if current.task_name == task_name:
                return current
            current = current.next
        return None

    def calculate_total_duration(self):
        total_duration = 0
        current = self.head
        while current is not None:
            total_duration += current.duration
            current = current.next
        return total_duration

    def read_tasks_from_csv(self, file_path):
